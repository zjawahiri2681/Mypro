<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext traffic anywhere. Media is DTLS-SRTP; signalling is TLS MQTT. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
